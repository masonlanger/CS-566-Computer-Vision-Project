---
import astroLogo from '../assets/astro.svg';
import * as intro from '../pages/Intro.md';
import * as future from '../pages/FutureConsiderations.md';
import * as implementation from '../pages/Implementation.md';
import * as background from '../pages/Background.md';
import Reference from './Reference.astro';
---

<div id="container">
	<main>
		<section id="hero">
			<h1 class="title mb-0-1">World-Space Player Tracking & Re-identification Under Partial Visibility in Broadcast Soccer Footage</h1>
			<h2 class="fw-500 m-0 mb-0-25">University of Wisconsin - Madison (COMP SCI 566)</h2>
			<div id="authors">
				<p class="m-0">William Cong</p>
				<p class="m-0">Arul Aravinthan</p>
				<p class="m-0">Mason Langer</p>
				<p class="m-0">Beomjong Lee</p>
			</div>
			<div class="w-3-4 m-auto">
				<intro.Content />
			</div>
			<div class="w-3-4 m-auto">
				<background.Content />
			</div>
			<div class="w-3-4 m-auto">
				<implementation.Content />
				<div class="w-100 mb-1">
					<video controls class="w-100">
						<source src="/CS-566-Computer-Vision-Project/videos/demo-1-easy.mp4" type="video/mp4">
					</video>
					<div class="center mt-1">
						<em>Video 1: Easy case (no camera switch)</em>
					</div>
				</div>
				<div class="w-100 mb-1">
					<video controls class="w-100">
						<source src="/CS-566-Computer-Vision-Project/videos/demo-2-easy.mp4" type="video/mp4">
					</video>
					<div class="center mt-1">
						<em>Video 2: Easy case (with zoom out, "hidden" players)</em>
					</div>
				</div>
				<div class="w-100 mb-1">
					<video controls class="w-100">
						<source src="/CS-566-Computer-Vision-Project/videos/demo-3-hard.mp4" type="video/mp4">		
					</video>
					<div class="center mt-1">
						<em>Video 3: Hard case (quick camera panning)</em>
					</div>
				</div>
				<div>
					<video controls class="w-100">
						<source src="/CS-566-Computer-Vision-Project/videos/demo-4-bad-homography.mp4" type="video/mp4">
					</video>
					<div class="center mt-1">
						<em>Video 4: Bad homography estimation</em>
					</div>
				</div>
			</div>

			<div class="w-3-4 m-auto">
				<future.Content />
			</div>
		</section>
		<section id="references" class="m-auto">
			<h2>References</h2>
			<ul>
				<Reference author="Majeed et. al" article={true} title="Real-time analysis of soccer ball–player interactions using graph convolutional networks for enhanced game insights" source="Sci Rep" volume="15" year="2025" url="https://doi.org/10.1038/s41598-025-05462-7"/>
				<Reference author="Bewley et. al" article={true} title="Simple online and realtime tracking" source="2016 IEEE International Conference on Computer Vision (ICCV)" year="2016" url="http://dx.doi.org/10.1109/ICIP.2016.7533003"/>
			</ul>
		</section>
	</main>
</div>

<style is:global>
	.w-100 {
		width: 100%;
	}
	.w-50 {
		width: 50%;
	}
	.w-2-3 {
		width: 66.6667%;
	}

	.w-3-4 {
		width: 75%;
	}

	.title {
		font-size: 3rem;
		font-weight: 600;
		color: #111827;
	}
	.fw-500 {
		font-weight: 500;
	}
	.fw-600 {
		font-weight: 600;
	}
	.m-0 {
		margin: 0;
	}
	.mb-0 {
		margin-bottom: 0;
	}

	.mb-0-1 {
		margin-bottom: 0.1em;
	}

	.mb-0-25 {
		margin-bottom: 0.25em;
	}

	.mb-0-5 {
		margin-bottom: 0.5em;
	}

	.mb-1 {
		margin-bottom: 1em;
	}
	.mb-2 {	
		margin-bottom: 2em;
	}

	.mt-1 {
		margin-top: 1em;
	}
	.mt-0-5 {
		margin-top: 0.5em;
	}

	.mt-2 {
		margin-top: 2em;
	}

	.center {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.m-auto {
		margin: auto;
	}
</style>
<style>

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		padding-bottom: 5rem;
	}

	main {
		width: 80%;
		height: auto;
		padding-top: 2.5%;
		padding-left: 10%;
		justify-content: center;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: flex-start;
	}

	#authors {
		width: 100%;
		display: flex;
		flex-direction: row;
		font-size: 18px;
		gap: 12px;
	}

	#links {
		display: flex;
		gap: 16px;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	code {
		display: inline-block;
		background:
			linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
			linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
		border-radius: 8px;
		border: 1px solid transparent;
		padding: 6px 8px;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	#news {
		position: absolute;
		bottom: 16px;
		right: 16px;
		max-width: 300px;
		text-decoration: none;
		transition: background 0.2s;
		backdrop-filter: blur(50px);
	}

	#news:hover {
		background: rgba(255, 255, 255, 0.55);
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			display: block;
			padding-top: 10%;
		}

		#links {
			flex-wrap: wrap;
		}

		#links a.button {
			padding: 14px 18px;
		}

		#news {
			right: 16px;
			left: 16px;
			bottom: 2.5rem;
			max-width: 100%;
		}

		h1 {
			line-height: 1.5;
		}
	}
</style>
